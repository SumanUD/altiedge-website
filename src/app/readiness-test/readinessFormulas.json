{
  "phase1": {
    "bmi": {
      "type": "relative",
      "control": 23.5,
      "formula": "value => value > 23.5 ? (23.5/value)*100 : (value/23.5)*100",
      "weight": 0.35
    },
    "bmr": {
      "type": "absolute",
      "formulaMale": "66.4730 + (13.7516 * weight) + (5.0033 * height) - (6.7550 * age)",
      "formulaFemale": "655.0955 + (9.5634 * weight) + (1.8496 * height) - (4.6756 * age)"
    },
    "vo2max": {
      "type": "relative",
      "control": 68,
      "formula": "(15 * maxHR / restingHR) / 68 * 100",
      "weight": 0.35
    },
    "trainingVolume": {
      "type": "relative",
      "control": 900,
      "formula": "(workoutDays * workoutMinutes) / 900 * 100",
      "weight": 0.10
    },
    "activityFactor": {
      "type": "absolute",
      "formula": "1-3 days = 1.375, 3-5 = 1.55, 6 = 1.725, 7 = 1.9"
    },
    "tdee": {
      "type": "absolute",
      "formula": "BMR * ActivityFactor"
    },
    "age": {
      "formula": "(100 - age)",
      "weight": 0.05
    },
    "injury": {
      "formula": "value === 'no' ? 100 : 50",
      "weight": 0.05
    },
    "mindfulness": {
      "formula": "value === 'yes' ? 100 : 20",
      "weight": 0.05
    },
    "condition": {
      "formula": "value === 'no' ? 100 : 50",
      "weight": 0.05
    },
    "final": {
      "formula": "(bmi*0.35) + (vo2max*0.35) + (trainingVolume*0.10) + (age*0.05) + (injury*0.05) + (mindfulness*0.05) + (condition*0.05)"
    }
  },
  "phase2": {
    "cardio": {
      "controlRun": 0.3,
      "controlBurpees": 100,
      "formula": "(( (speed * distanceFactor)/0.3 * 100 )*0.8) + ((burpees/100*100)*0.2)",
      "weight": 0.5
    },
    "core": {
      "controlCrunch": 60,
      "controlBalance": 60,
      "formula": "((crunches/60*100)*0.6) + ((balance/60*100)*0.4)",
      "weight": 0.1
    },
    "muscle": {
      "controls": {
        "squat": 100,
        "pullup": 15,
        "pushup": 60,
        "dips": 50
      },
      "formula": "((squats/100*100)*0.5) + ((pullups/15*100)*0.2) + ((pushups/60*100)*0.15) + ((dips/50*100)*0.15)",
      "weight": 0.4
    },
    "final": {
      "formula": "(cardio*0.5) + (muscle*0.4) + (core*0.1)"
    }
  },
  "phase3": {
    "experience": {
      "control": 1000,
      "formula": "((25*count5000) + (35*count6000) + (55*count7000) + (100*count8000)) / 1000 * 100",
      "weight": 0.7
    },
    "illness": {
      "formula": "value === 'none' ? 100 : (value === 'AMS' ? 80 : 60)",
      "weight": 0.15
    },
    "training": {
      "formula": "value === 'AMC' ? 100 : (value === 'BMC' ? 60 : 0)",
      "weight": 0.15
    },
    "final": {
      "formula": "(experience*0.7) + (illness*0.15) + (training*0.15)"
    }
  },
  "overall": {
    "formula": "(phase2*0.55) + (phase1*0.30) + (phase3*0.15)"
  }
}
